{
  "name": "lifeos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run db:setup:local",
    "dev": "concurrently --kill-others --names web,api --prefix-colors blue,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite dev",
    "dev:api": "wrangler dev --local --config wrangler.worker.toml --port 8787 --persist-to .wrangler/state",
    "build": "vite build",
    "build:worker": "wrangler deploy --dry-run --config wrangler.worker.toml --outdir .wrangler/worker-build",
    "build:mcp": "wrangler deploy --dry-run --config wrangler.mcp.toml --outdir .wrangler/mcp-build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "typecheck": "npm run check",
    "deploy": "npm run deploy:web && npm run deploy:mcp",
    "deploy:web": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name lifeos --branch production",
    "deploy:mcp": "wrangler deploy --config wrangler.mcp.toml",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:local": "wrangler d1 migrations apply lifeos --local --config wrangler.worker.toml --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute lifeos --local --config wrangler.worker.toml --persist-to .wrangler/state --file scripts/seed-local-d1.sql --yes",
    "db:migrate:remote": "wrangler d1 migrations apply lifeos --remote",
    "pwa:assets": "pwa-assets-generator --preset minimal public/favicon.svg"
  },
  "dependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@lucide/svelte": "^1.59.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^1.0.4",
    "concurrently": "^10.0.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.45.0"
  }
}
